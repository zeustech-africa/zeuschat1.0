# REGISTRATION API
# ============================================

@app.route('/api/start-signup', methods=['POST'])
def start_signup():
    try:
        data = request.get_json()
        email = data.get('email', '').strip()
        if not email:
            return jsonify({'success': False, 'error': 'Email required'}), 400
        return jsonify({'success': True, 'message': 'OTP sent', 'otp': '123456', 'requires_otp': True})
    except Exception as e:
        return jsonify({'success': False, 'error': str(e)}), 500

@app.route('/api/verify-otp', methods=['POST'])
def verify_otp():
    try:
        data = request.get_json()
        otp = data.get('otp', '').strip()
        if otp != '123456':
            return jsonify({'success': False, 'error': 'Invalid OTP'}), 400
        zeus_pin = f"ZT-{random.randint(1000, 9999)}-{random.randint(1000, 9999)}"
        return jsonify({'success': True, 'zeus_pin': zeus_pin, 'message': 'Verified'})
    except Exception as e:
        return jsonify({'success': False, 'error': str(e)}), 500

@app.route('/api/complete-registration', methods=['POST'])
def complete_registration():
    try:
        data = request.get_json()
        zeus_pin = data.get('zeus_pin', '').strip()
        password = data.get('password', '').strip()
        full_name = data.get('full_name', '').strip()
        if not zeus_pin or not password:
            return jsonify({'success': False, 'error': 'ZeusPIN and password required'}), 400
        conn = get_db()
        cursor = conn.cursor()
        cursor.execute('INSERT INTO users (zeus_pin, password, full_name, created_at) VALUES (?, ?, ?, CURRENT_TIMESTAMP)', (zeus_pin, password, full_name))
        conn.commit()
        conn.close()
        return jsonify({'success': True, 'message': 'Registration complete'})
    except Exception as e:
        return jsonify({'success': False, 'error': str(e)}), 500

# ============================================
# GHOST MARKET API
# ============================================

@app.route('/api/market/listings', methods=['GET'])
def get_market_listings():
    try:
        conn = get_db()
        cursor = conn.cursor()
        cursor.execute('SELECT id, title, price, images FROM ghost_market_listings WHERE status = "active" LIMIT 50')
        listings = [dict(row) for row in cursor.fetchall()]
        conn.close()
        return jsonify({'success': True, 'listings': listings})
    except Exception as e:
        return jsonify({'success': False, 'error': str(e)}), 500

# ============================================
# REDIRECT MOBILE USERS
# ============================================

@app.before_request
def redirect_mobile_users():
    path = request.path
    if path.startswith(('/api/', '/static/', '/admin')):
        return None
    if path.startswith('/mobile'):
        return None
    if path == '/' or path == '':
        if is_mobile_device():
            return redirect('/mobile')
    return None

