@app.route('/api/market/listings', methods=['GET'])
def get_market_listings():
    try:
        conn = get_db()
        cursor = conn.cursor()
        cursor.execute('''
            SELECT id, title, price, images, condition, created_at
            FROM ghost_market_listings
            WHERE status = 'active'
            ORDER BY created_at DESC
            LIMIT 50
        ''')
        listings = [dict(row) for row in cursor.fetchall()]
        conn.close()
        return jsonify({'success': True, 'listings': listings})
    except Exception as e:
        return jsonify({'success': False, 'error': str(e)}), 500

@app.route('/api/market/save', methods=['POST'])
@login_required
def save_listing():
    try:
        user_id = session.get('user_id')
        data = request.get_json()
        listing_id = data.get('listing_id')
        conn = get_db()
        cursor = conn.cursor()
        cursor.execute('INSERT INTO saved_listings (user_id, listing_id) VALUES (?, ?)', (user_id, listing_id))
        conn.commit()
        conn.close()
        return jsonify({'success': True})
    except Exception as e:
        return jsonify({'success': False, 'error': str(e)}), 500

@app.route('/api/market/inquire', methods=['POST'])
@login_required
def market_inquire():
    try:
        buyer_id = session.get('user_id')
        data = request.get_json()
        listing_id = data.get('listing_id')
        message = data.get('message', '')
        conn = get_db()
        cursor = conn.cursor()
        cursor.execute('''
            INSERT INTO market_inquiries (listing_id, buyer_id, message)
            VALUES (?, ?, ?)
        ''', (listing_id, buyer_id, message))
        conn.commit()
        conn.close()
        return jsonify({'success': True})
    except Exception as e:
        return jsonify({'success': False, 'error': str(e)}), 500


@app.route('/api/market/shop/<int:seller_id>', methods=['GET'])
def get_shop_page(seller_id):
    try:
        conn = get_db()
        cursor = conn.cursor()
        cursor.execute('''
            SELECT u.zeus_pin, u.full_name,
                   (SELECT COUNT(*) FROM ghost_market_listings WHERE seller_id = ? AND status = 'active') as item_count
            FROM users u
            WHERE u.id = ?
        ''', (seller_id, seller_id))
        shop = cursor.fetchone()
        if not shop:
            conn.close()
            return jsonify({'success': False, 'error': 'Shop not found'}), 404
        cursor.execute('''
            SELECT id, title, price, images
            FROM ghost_market_listings
            WHERE seller_id = ? AND status = 'active'
            ORDER BY created_at DESC
        ''', (seller_id,))
        listings = [dict(row) for row in cursor.fetchall()]
        conn.close()
        return jsonify({
            'success': True,
            'shop': {'name': shop['full_name'][:3] + '***', 'item_count': shop['item_count'] or 0},
            'listings': listings
        })
    except Exception as e:
        return jsonify({'success': False, 'error': str(e)}), 500


@app.route('/api/shipping/mark-shipped', methods=['POST'])
@login_required
def mark_shipped():
    try:
        user_id = session.get('user_id')
        data = request.get_json()
        transaction_id = data.get('transaction_id')
        tracking_number = data.get('tracking_number')
        conn = get_db()
        cursor = conn.cursor()
        cursor.execute('''
            UPDATE escrow_transactions
            SET shipping_status = 'shipped', tracking_number = ?, shipped_at = CURRENT_TIMESTAMP
            WHERE id = ? AND seller_id = ?
        ''', (tracking_number, transaction_id, user_id))
        conn.commit()
        conn.close()
        return jsonify({'success': True})
    except Exception as e:
        return jsonify({'success': False, 'error': str(e)}), 500

@app.route('/api/shipping/confirm-receipt', methods=['POST'])
@login_required
def confirm_receipt():
    try:
        user_id = session.get('user_id')
        data = request.get_json()
        transaction_id = data.get('transaction_id')
        conn = get_db()
        cursor = conn.cursor()
        cursor.execute('''
            UPDATE escrow_transactions
            SET buyer_confirmed = 1, status = 'completed', completed_at = CURRENT_TIMESTAMP
            WHERE id = ? AND buyer_id = ?
        ''', (transaction_id, user_id))
        conn.commit()
        conn.close()
        return jsonify({'success': True})
    except Exception as e:
        return jsonify({'success': False, 'error': str(e)}), 500


SCAM_KEYWORDS = ['paypal', 'cashapp', 'venmo', 'bank transfer', 'gift card', 'whatsapp me', 'call me']
OFF_PLATFORM_KEYWORDS = ['email', 'gmail', 'phone', 'whatsapp', 'telegram']

def detect_scam_keywords(message):
    message_lower = message.lower()
    return [kw for kw in SCAM_KEYWORDS if kw in message_lower]

@app.route('/api/market/check-message-safety', methods=['POST'])
@login_required
def check_message_safety():
    try:
        data = request.get_json()
        message = data.get('message', '')
        scam_words = detect_scam_keywords(message)
        warnings = []
        if scam_words:
            warnings.append({'type': 'scam', 'message': 'This message contains scam indicators', 'keywords': scam_words})
        return jsonify({'success': True, 'is_safe': len(warnings) == 0, 'warnings': warnings})
    except Exception as e:
        return jsonify({'success': False, 'error': str(e)}), 500


@app.route('/api/admin/stats', methods=['GET'])
@admin_required
def admin_stats():
    try:
        conn = get_db()
        cursor = conn.cursor()
        cursor.execute('SELECT COUNT(*) as total FROM users')
        total_users = cursor.fetchone()['total']
        conn.close()
        return jsonify({'success': True, 'total_users': total_users})
    except Exception as e:
        return jsonify({'success': False, 'error': str(e)}), 500


@app.before_request
def redirect_mobile_users():
    path = request.path
    if path.startswith(('/api/', '/static/', '/admin')):
        return None
    if path.startswith('/mobile'):
        return None
    if path == '/' or path == '':
        if is_mobile_device():
            return redirect('/mobile')
    return None



