<!DOCTYPE html>
<html lang="en">
<head>
        <link rel="stylesheet" href="/static/css/video-background.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Ghost Market - ZeusChat</title>
    <link rel="stylesheet" href="/static/mobile.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 100%);
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            color: white;
            padding-bottom: 80px;
        }
        .container { max-width: 1200px; margin: 0 auto; padding: 20px; }
        .market-header {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }
        .back-btn {
            background: rgba(212, 175, 55, 0.2);
            border: 1px solid #D4AF37;
            color: #D4AF37;
            padding: 10px 16px;
            border-radius: 40px;
            cursor: pointer;
            font-size: 14px;
        }
        .back-btn:hover {
            background: rgba(212, 175, 55, 0.4);
        }
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
            flex-wrap: wrap;
            gap: 15px;
        }
        h1 {
            color: #D4AF37;
            font-size: 28px;
        }
        .subtitle {
            color: rgba(255,255,255,0.6);
            margin-bottom: 24px;
        }
        .market-tabs {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }
        .tab-btn {
            border: 1px solid rgba(212,175,55,0.35);
            background: rgba(255,255,255,0.08);
            color: #e5e7eb;
            border-radius: 999px;
            padding: 10px 16px;
            cursor: pointer;
            min-height: 44px;
            font-weight: 600;
        }
        .tab-btn.active {
            background: linear-gradient(135deg, #D4AF37 0%, #B8960C 100%);
            color: #0a0a0a;
            border-color: #D4AF37;
        }
        .search-bar {
            display: flex;
            gap: 10px;
            margin-bottom: 24px;
            flex-wrap: wrap;
        }
        .search-bar input {
            flex: 1;
            padding: 14px;
            background: rgba(255,255,255,0.1);
            border: 1px solid rgba(212,175,55,0.3);
            border-radius: 40px;
            color: white;
            font-size: 16px;
            min-height: 44px;
        }
        .search-bar select, .search-bar button {
            padding: 14px 20px;
            background: rgba(255,255,255,0.1);
            border: 1px solid rgba(212,175,55,0.3);
            border-radius: 40px;
            color: white;
            cursor: pointer;
            min-height: 44px;
        }
        .search-bar select option { background: #1a1a1a; }
        .items-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }
        .item-card {
            background: rgba(17, 17, 17, 0.95);
            border: 1px solid rgba(212,175,55,0.2);
            border-radius: 20px;
            overflow: hidden;
            transition: transform 0.2s;
            cursor: pointer;
        }
        .item-card:hover { transform: translateY(-4px); }
        .item-image {
            width: 100%;
            height: 200px;
            background: #1a1a1a;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #D4AF37;
            font-size: 48px;
        }
        .item-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .item-info { padding: 16px; }
        .item-title {
            font-weight: 600;
            margin-bottom: 8px;
            font-size: 16px;
        }
        .item-price {
            color: #D4AF37;
            font-size: 20px;
            font-weight: bold;
            margin-bottom: 8px;
        }
        .item-seller {
            font-size: 12px;
            color: rgba(255,255,255,0.5);
            margin-bottom: 12px;
        }
        .item-status {
            min-height: 22px;
            margin-bottom: 10px;
        }
        .status-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 11px;
            margin-top: 2px;
            font-weight: 600;
        }
        .status-badge.pending {
            background: #fef3c7;
            color: #d97706;
        }
        .status-badge.rejected {
            background: #fee2e2;
            color: #dc2626;
        }
        .buy-btn[disabled] {
            cursor: not-allowed;
            background: #374151;
            color: #d1d5db;
        }
        .buy-btn {
            width: 100%;
            padding: 12px;
            background: linear-gradient(135deg, #D4AF37 0%, #B8960C 100%);
            color: #0a0a0a;
            border: none;
            border-radius: 40px;
            font-weight: bold;
            cursor: pointer;
            min-height: 44px;
        }
        .seller-section {
            margin-top: 40px;
            padding: 20px;
            background: rgba(212,175,55,0.1);
            border-radius: 20px;
            text-align: center;
        }
        .seller-section h3 { margin-bottom: 8px; color: #D4AF37; }
        .seller-section p { color: rgba(255,255,255,0.6); margin-bottom: 16px; }
        .note {
            color: rgba(255,255,255,0.45);
            font-size: 12px;
            margin-top: 10px;
        }
        .sell-btn {
            padding: 14px 28px;
            background: linear-gradient(135deg, #D4AF37 0%, #B8960C 100%);
            color: #0a0a0a;